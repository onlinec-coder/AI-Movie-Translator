{
  "schema_version": "1.0.0",
  "source": {
    "filename": "Husbands.mp4",
    "source_offset_seconds": 0.0
  },
  "analysis_window": {
    "start_seconds": 0.0,
    "base_window_end_seconds": 300.0,
    "last_subtitle_end_seconds": 301.87,
    "required_end_seconds": 302.87,
    "extraction_duration_seconds": 310
  },
  "statistics": {
    "total_subtitles": 908,
    "subtitles_in_window": 96
  },
  "segments": [
    {
      "subtitle_id": 1,
      "start_seconds": 9.07,
      "end_seconds": 13.47,
      "duration_seconds": 4.4,
      "text": "The third bowl tasted like rot.\nI couldn't feel my hands anymore."
    },
    {
      "subtitle_id": 2,
      "start_seconds": 13.471,
      "end_seconds": 15.807,
      "duration_seconds": 2.336,
      "text": "The wolf bead had\nalready reached my chest."
    },
    {
      "subtitle_id": 3,
      "start_seconds": 15.831,
      "end_seconds": 18.757,
      "duration_seconds": 2.926,
      "text": "Lucian stood at the dend of\nthe bed and watched me go."
    },
    {
      "subtitle_id": 4,
      "start_seconds": 18.758,
      "end_seconds": 21.79,
      "duration_seconds": 3.032,
      "text": "Seven pups, whole high-ranking blood.\nThat's enough."
    },
    {
      "subtitle_id": 5,
      "start_seconds": 21.791,
      "end_seconds": 24.27,
      "duration_seconds": 2.479,
      "text": "I tried to speak. Nothing came out."
    },
    {
      "subtitle_id": 6,
      "start_seconds": 26.11,
      "end_seconds": 28.03,
      "duration_seconds": 1.92,
      "text": "You were never the one I wanted Vivienne."
    },
    {
      "subtitle_id": 7,
      "start_seconds": 29.23,
      "end_seconds": 30.43,
      "duration_seconds": 1.2,
      "text": "His voice didn't waver."
    },
    {
      "subtitle_id": 8,
      "start_seconds": 30.869,
      "end_seconds": 35.79,
      "duration_seconds": 4.921,
      "text": "You threw yourself at me.\nI let it happen. That's all this ever was."
    },
    {
      "subtitle_id": 9,
      "start_seconds": 35.791,
      "end_seconds": 38.83,
      "duration_seconds": 3.039,
      "text": "I wanted to scream.\nI wanted to tear him apart."
    },
    {
      "subtitle_id": 10,
      "start_seconds": 39.07,
      "end_seconds": 40.67,
      "duration_seconds": 1.6,
      "text": "But my body was already gone."
    },
    {
      "subtitle_id": 11,
      "start_seconds": 41.87,
      "end_seconds": 43.23,
      "duration_seconds": 1.36,
      "text": "You've served your purpose."
    },
    {
      "subtitle_id": 12,
      "start_seconds": 45.38,
      "end_seconds": 46.82,
      "duration_seconds": 1.44,
      "text": "He set the empty bowl down."
    },
    {
      "subtitle_id": 13,
      "start_seconds": 47.46,
      "end_seconds": 48.42,
      "duration_seconds": 0.96,
      "text": "Rest now."
    },
    {
      "subtitle_id": 14,
      "start_seconds": 48.421,
      "end_seconds": 51.06,
      "duration_seconds": 2.639,
      "text": "My heartbeat slowed. Then nothing."
    },
    {
      "subtitle_id": 15,
      "start_seconds": 52.58,
      "end_seconds": 56.74,
      "duration_seconds": 4.16,
      "text": "I opened my eyes. In my mother's\nsitting room at Coldwell Manor."
    },
    {
      "subtitle_id": 16,
      "start_seconds": 59.39,
      "end_seconds": 60.39,
      "duration_seconds": 1.0,
      "text": "I came back."
    },
    {
      "subtitle_id": 17,
      "start_seconds": 61.765,
      "end_seconds": 65.39,
      "duration_seconds": 3.625,
      "text": "I pressed my hands flat\nagainst my thighs and breathed."
    },
    {
      "subtitle_id": 18,
      "start_seconds": 65.391,
      "end_seconds": 68.27,
      "duration_seconds": 2.879,
      "text": "My mother was holding a\ncontract across the room."
    },
    {
      "subtitle_id": 19,
      "start_seconds": 68.271,
      "end_seconds": 72.43,
      "duration_seconds": 4.159,
      "text": "A mating bond contract, sealed\nwith the Blood Moon Pack crest."
    },
    {
      "subtitle_id": 20,
      "start_seconds": 72.431,
      "end_seconds": 73.55,
      "duration_seconds": 1.119,
      "text": "The name line was blank."
    },
    {
      "subtitle_id": 21,
      "start_seconds": 74.51,
      "end_seconds": 77.87,
      "duration_seconds": 3.36,
      "text": "The Velice's heir sent this\nearlier this morning, Vivienne."
    },
    {
      "subtitle_id": 22,
      "start_seconds": 77.871,
      "end_seconds": 79.47,
      "duration_seconds": 1.599,
      "text": "Is it you he's asking for?"
    },
    {
      "subtitle_id": 23,
      "start_seconds": 79.471,
      "end_seconds": 83.47,
      "duration_seconds": 3.999,
      "text": "Lucian sat across from her.\nSame face. Same steady eyes."
    },
    {
      "subtitle_id": 24,
      "start_seconds": 83.471,
      "end_seconds": 84.831,
      "duration_seconds": 1.36,
      "text": "Like none of it had ever happened."
    },
    {
      "subtitle_id": 25,
      "start_seconds": 86.19,
      "end_seconds": 88.19,
      "duration_seconds": 2.0,
      "text": "I can marry Vivienne. I don't mind."
    },
    {
      "subtitle_id": 26,
      "start_seconds": 88.191,
      "end_seconds": 90.91,
      "duration_seconds": 2.719,
      "text": "I don't mind. Seven years. Seven children."
    },
    {
      "subtitle_id": 27,
      "start_seconds": 90.911,
      "end_seconds": 92.51,
      "duration_seconds": 1.599,
      "text": "Three bowls of wolf's babe."
    },
    {
      "subtitle_id": 28,
      "start_seconds": 92.511,
      "end_seconds": 93.511,
      "duration_seconds": 1.0,
      "text": "No."
    },
    {
      "subtitle_id": 29,
      "start_seconds": 94.19,
      "end_seconds": 95.19,
      "duration_seconds": 1.0,
      "text": "Silence."
    },
    {
      "subtitle_id": 30,
      "start_seconds": 95.43,
      "end_seconds": 99.47,
      "duration_seconds": 4.04,
      "text": "Viviana.\nYou've wanted this since you were 12."
    },
    {
      "subtitle_id": 31,
      "start_seconds": 101.39,
      "end_seconds": 102.99,
      "duration_seconds": 1.6,
      "text": "I was a kid. I didn't know any better."
    },
    {
      "subtitle_id": 32,
      "start_seconds": 102.991,
      "end_seconds": 106.59,
      "duration_seconds": 3.599,
      "text": "Lucian looked at me.\nThat calm, unerisval stare."
    },
    {
      "subtitle_id": 33,
      "start_seconds": 106.591,
      "end_seconds": 109.23,
      "duration_seconds": 2.639,
      "text": "I used to think meant he\nwas hiding something tender."
    },
    {
      "subtitle_id": 34,
      "start_seconds": 109.231,
      "end_seconds": 110.231,
      "duration_seconds": 1.0,
      "text": "Now I knew better."
    },
    {
      "subtitle_id": 35,
      "start_seconds": 111.699,
      "end_seconds": 114.83,
      "duration_seconds": 3.131,
      "text": "I also have someone.\nHe'll be here soon with his own contract."
    },
    {
      "subtitle_id": 36,
      "start_seconds": 115.569,
      "end_seconds": 117.31,
      "duration_seconds": 1.741,
      "text": "My mother's head snapped toward Aria."
    },
    {
      "subtitle_id": 37,
      "start_seconds": 117.87,
      "end_seconds": 120.67,
      "duration_seconds": 2.8,
      "text": "Aria had been quiet in\nthe corner this whole time."
    },
    {
      "subtitle_id": 38,
      "start_seconds": 120.671,
      "end_seconds": 122.03,
      "duration_seconds": 1.359,
      "text": "Now she shook her head hard."
    },
    {
      "subtitle_id": 39,
      "start_seconds": 122.83,
      "end_seconds": 124.35,
      "duration_seconds": 1.52,
      "text": "Same. I'm not available either."
    },
    {
      "subtitle_id": 40,
      "start_seconds": 124.75,
      "end_seconds": 127.95,
      "duration_seconds": 3.2,
      "text": "My mother turned back\nto Lucian with a tight smile."
    },
    {
      "subtitle_id": 41,
      "start_seconds": 127.951,
      "end_seconds": 133.81,
      "duration_seconds": 5.859,
      "text": "I'm so sorry. It seems both my\ndaughters have prior commitments."
    },
    {
      "subtitle_id": 42,
      "start_seconds": 135.84,
      "end_seconds": 136.88,
      "duration_seconds": 1.04,
      "text": "Perhaps another pack?"
    },
    {
      "subtitle_id": 43,
      "start_seconds": 137.52,
      "end_seconds": 139.76,
      "duration_seconds": 2.24,
      "text": "No. Lucian stood."
    },
    {
      "subtitle_id": 44,
      "start_seconds": 139.761,
      "end_seconds": 143.2,
      "duration_seconds": 3.439,
      "text": "The Alpha Aura rolled off\nhim slow and deliberate,"
    },
    {
      "subtitle_id": 45,
      "start_seconds": 143.201,
      "end_seconds": 145.2,
      "duration_seconds": 1.999,
      "text": "pressing into every\ncorner of the room."
    },
    {
      "subtitle_id": 46,
      "start_seconds": 146.47,
      "end_seconds": 149.04,
      "duration_seconds": 2.57,
      "text": "The woman I marry comes\nfrom the Coldwild family."
    },
    {
      "subtitle_id": 47,
      "start_seconds": 149.041,
      "end_seconds": 151.44,
      "duration_seconds": 2.399,
      "text": "His voice left no room for argument."
    },
    {
      "subtitle_id": 48,
      "start_seconds": 151.441,
      "end_seconds": 152.72,
      "duration_seconds": 1.279,
      "text": "That's not changing."
    },
    {
      "subtitle_id": 49,
      "start_seconds": 152.721,
      "end_seconds": 155.44,
      "duration_seconds": 2.719,
      "text": "He picked up the contract\nand dropped it on the table."
    },
    {
      "subtitle_id": 50,
      "start_seconds": 156.39,
      "end_seconds": 158.72,
      "duration_seconds": 2.33,
      "text": "The sound cut through\nthe silence like a blade."
    },
    {
      "subtitle_id": 51,
      "start_seconds": 159.79,
      "end_seconds": 163.52,
      "duration_seconds": 3.73,
      "text": "You have three days. Decide who it is."
    },
    {
      "subtitle_id": 52,
      "start_seconds": 163.521,
      "end_seconds": 164.64,
      "duration_seconds": 1.119,
      "text": "Nobody moved."
    },
    {
      "subtitle_id": 53,
      "start_seconds": 164.641,
      "end_seconds": 165.68,
      "duration_seconds": 1.039,
      "text": "If you can't choose."
    },
    {
      "subtitle_id": 54,
      "start_seconds": 167.2,
      "end_seconds": 168.4,
      "duration_seconds": 1.2,
      "text": "He straightened his jacket."
    },
    {
      "subtitle_id": 55,
      "start_seconds": 170.7,
      "end_seconds": 172.38,
      "duration_seconds": 1.68,
      "text": "I'll take it to the Alpha King."
    },
    {
      "subtitle_id": 56,
      "start_seconds": 172.381,
      "end_seconds": 177.78,
      "duration_seconds": 5.399,
      "text": "One word from him and it\nbecomes a royal be a choice after that."
    },
    {
      "subtitle_id": 57,
      "start_seconds": 179.14,
      "end_seconds": 180.82,
      "duration_seconds": 1.68,
      "text": "He walked out without looking back."
    },
    {
      "subtitle_id": 58,
      "start_seconds": 181.38,
      "end_seconds": 184.417,
      "duration_seconds": 3.037,
      "text": "The door hadn't finished\nclosing before Aria"
    },
    {
      "subtitle_id": 59,
      "start_seconds": 184.467,
      "end_seconds": 186.58,
      "duration_seconds": 2.113,
      "text": "grabbed my wrist and\npulled me down the hall."
    },
    {
      "subtitle_id": 60,
      "start_seconds": 189.455,
      "end_seconds": 192.58,
      "duration_seconds": 3.125,
      "text": "She shut us into my bedroom and\npressed her back against the door."
    },
    {
      "subtitle_id": 61,
      "start_seconds": 193.46,
      "end_seconds": 194.5,
      "duration_seconds": 1.04,
      "text": "Her face was white."
    },
    {
      "subtitle_id": 62,
      "start_seconds": 195.195,
      "end_seconds": 198.02,
      "duration_seconds": 2.825,
      "text": "I'll tell you something, but you\nhave to promise not to feel guilty."
    },
    {
      "subtitle_id": 63,
      "start_seconds": 198.07,
      "end_seconds": 199.7,
      "duration_seconds": 1.63,
      "text": "She said, I went still."
    },
    {
      "subtitle_id": 64,
      "start_seconds": 200.98,
      "end_seconds": 202.98,
      "duration_seconds": 2.0,
      "text": "Aria, promise me first."
    },
    {
      "subtitle_id": 65,
      "start_seconds": 204.234,
      "end_seconds": 206.26,
      "duration_seconds": 2.026,
      "text": "Something cold settled in my chest."
    },
    {
      "subtitle_id": 66,
      "start_seconds": 207.25,
      "end_seconds": 208.25,
      "duration_seconds": 1.0,
      "text": "I promise."
    },
    {
      "subtitle_id": 67,
      "start_seconds": 208.454,
      "end_seconds": 210.26,
      "duration_seconds": 1.806,
      "text": "She didn't look at me when she spoke."
    },
    {
      "subtitle_id": 68,
      "start_seconds": 211.414,
      "end_seconds": 212.9,
      "duration_seconds": 1.486,
      "text": "In another life."
    },
    {
      "subtitle_id": 69,
      "start_seconds": 212.901,
      "end_seconds": 215.7,
      "duration_seconds": 2.799,
      "text": "She said quietly, you gave me the contract."
    },
    {
      "subtitle_id": 70,
      "start_seconds": 216.18,
      "end_seconds": 218.18,
      "duration_seconds": 2.0,
      "text": "You told me Lucian loved me."
    },
    {
      "subtitle_id": 71,
      "start_seconds": 218.181,
      "end_seconds": 220.18,
      "duration_seconds": 1.999,
      "text": "You stepped aside."
    },
    {
      "subtitle_id": 72,
      "start_seconds": 220.181,
      "end_seconds": 222.18,
      "duration_seconds": 1.999,
      "text": "I couldn't breathe."
    },
    {
      "subtitle_id": 73,
      "start_seconds": 222.181,
      "end_seconds": 224.18,
      "duration_seconds": 1.999,
      "text": "He didn't love me."
    },
    {
      "subtitle_id": 74,
      "start_seconds": 224.23,
      "end_seconds": 226.18,
      "duration_seconds": 1.95,
      "text": "Her voice was flat, controlled."
    },
    {
      "subtitle_id": 75,
      "start_seconds": 226.181,
      "end_seconds": 228.18,
      "duration_seconds": 1.999,
      "text": "He kept me locked in a room."
    },
    {
      "subtitle_id": 76,
      "start_seconds": 228.181,
      "end_seconds": 234.7,
      "duration_seconds": 6.519,
      "text": "He said the only thing I was\ngood for was my Moon Veal voice."
    },
    {
      "subtitle_id": 77,
      "start_seconds": 234.701,
      "end_seconds": 236.7,
      "duration_seconds": 1.999,
      "text": "He made me sing for him every night."
    },
    {
      "subtitle_id": 78,
      "start_seconds": 238.7,
      "end_seconds": 240.7,
      "duration_seconds": 2.0,
      "text": "She paused."
    },
    {
      "subtitle_id": 79,
      "start_seconds": 243.63,
      "end_seconds": 251.63,
      "duration_seconds": 8.0,
      "text": "She finally looked at me."
    },
    {
      "subtitle_id": 80,
      "start_seconds": 251.631,
      "end_seconds": 253.63,
      "duration_seconds": 1.999,
      "text": "Her eyes were dry. That was somehow worse."
    },
    {
      "subtitle_id": 81,
      "start_seconds": 253.631,
      "end_seconds": 255.63,
      "duration_seconds": 1.999,
      "text": "He had my limbs\nsevered so I couldn't shift."
    },
    {
      "subtitle_id": 82,
      "start_seconds": 255.631,
      "end_seconds": 260.67,
      "duration_seconds": 5.039,
      "text": "He took my eyes."
    },
    {
      "subtitle_id": 83,
      "start_seconds": 260.671,
      "end_seconds": 264.67,
      "duration_seconds": 3.999,
      "text": "He left me my voice because that\nwas the only part of me he wanted."
    },
    {
      "subtitle_id": 84,
      "start_seconds": 265.86,
      "end_seconds": 273.86,
      "duration_seconds": 8.0,
      "text": "I made it back because\na servant broke the lock."
    },
    {
      "subtitle_id": 85,
      "start_seconds": 273.861,
      "end_seconds": 275.86,
      "duration_seconds": 1.999,
      "text": "I didn't last two months after that."
    },
    {
      "subtitle_id": 86,
      "start_seconds": 275.861,
      "end_seconds": 277.86,
      "duration_seconds": 1.999,
      "text": "I crossed the room and\npulled her into a hug."
    },
    {
      "subtitle_id": 87,
      "start_seconds": 277.861,
      "end_seconds": 279.86,
      "duration_seconds": 1.999,
      "text": "She went stiff for a second."
    },
    {
      "subtitle_id": 88,
      "start_seconds": 279.861,
      "end_seconds": 281.86,
      "duration_seconds": 1.999,
      "text": "Then her arms came up and held on."
    },
    {
      "subtitle_id": 89,
      "start_seconds": 281.861,
      "end_seconds": 283.86,
      "duration_seconds": 1.999,
      "text": "We stayed like that for a long moment."
    },
    {
      "subtitle_id": 90,
      "start_seconds": 283.861,
      "end_seconds": 285.86,
      "duration_seconds": 1.999,
      "text": "I pulled back, looked at her seriously."
    },
    {
      "subtitle_id": 91,
      "start_seconds": 285.861,
      "end_seconds": 287.86,
      "duration_seconds": 1.999,
      "text": "I have something to tell you too."
    },
    {
      "subtitle_id": 92,
      "start_seconds": 287.861,
      "end_seconds": 289.86,
      "duration_seconds": 1.999,
      "text": "I told her about\neverything I'd been through."
    },
    {
      "subtitle_id": 93,
      "start_seconds": 289.861,
      "end_seconds": 291.86,
      "duration_seconds": 1.999,
      "text": "Including that I had been reborn too."
    },
    {
      "subtitle_id": 94,
      "start_seconds": 291.861,
      "end_seconds": 295.86,
      "duration_seconds": 3.999,
      "text": "Arya's expression turned\npuzzled after learning the truth."
    },
    {
      "subtitle_id": 95,
      "start_seconds": 295.861,
      "end_seconds": 297.86,
      "duration_seconds": 1.999,
      "text": "So what do we do?"
    },
    {
      "subtitle_id": 96,
      "start_seconds": 297.861,
      "end_seconds": 301.87,
      "duration_seconds": 4.009,
      "text": "We tell mom."
    }
  ]
}